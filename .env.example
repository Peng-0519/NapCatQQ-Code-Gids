# Generate a private value with at least 32 random characters.
NAPCAT_TOKEN=replace-with-a-random-64-character-hex-token

# Keep this image pinned because bootstrap.cjs patches version-specific code.
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.19
NAPCAT_DEVICE_NAME=QQ-Farm-NapCat
NAPCAT_UID=1000
NAPCAT_GID=1000
